# Database (PostgreSQL - Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_study_planner?sslmode=require

# Auth.js / NextAuth
AUTH_SECRET=super-secret-auth-key-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Providers
OPENAI_API_KEY="
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Email Notifications (Resend)
